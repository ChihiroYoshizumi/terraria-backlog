<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <TShockServerDir Condition="'$(TShockServerDir)' == ''">$(MSBuildThisFileDirectory)../../.tshock-server</TShockServerDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TerrariaBacklog.Adapter.csproj" />
  </ItemGroup>

  <!--
    テストホストが TerrariaBacklogPlugin 型をロードできるよう、TShock 配布物の DLL を
    テスト出力へコピーする (メインプロジェクト側は実行時に TShock ホストから解決されるため
    Private=false にしているが、テストではホストが存在しないためここでは copy-local する)。
  -->
  <ItemGroup>
    <Reference Include="TerrariaServer">
      <HintPath>$(TShockServerDir)/bin/TerrariaServer.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OTAPI">
      <HintPath>$(TShockServerDir)/bin/OTAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TShockAPI">
      <HintPath>$(TShockServerDir)/ServerPlugins/TShockAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureTShockReferencesExistForTests" BeforeTargets="BeforeBuild;BeforeCompile;CoreCompile">
    <Error
      Condition="!Exists('$(TShockServerDir)/bin/TerrariaServer.dll') Or !Exists('$(TShockServerDir)/bin/OTAPI.dll') Or !Exists('$(TShockServerDir)/ServerPlugins/TShockAPI.dll')"
      Text="TShock reference assemblies not found under '$(TShockServerDir)'. Run scripts/setup-tshock.sh first (see adapter/README.md), or pass -p:TShockServerDir=/path/to/tshock-server." />
  </Target>

</Project>
