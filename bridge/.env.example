APP_NAME="Terraria Backlog Bridge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docs/design.md §2.1: 永続 DB / 永続 Queue / DB Session を MVP の前提にしない。
# アプリは DB_* を一切設定しなくても起動・テストできる。
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 正本にしない、再起動で消えてよいメモリキャッシュ (docs/design.md §2.1)。
CACHE_STORE=array

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Task 03: Backlog API ---
# docs/design.md §9.3 / §13。ID は実環境から取得した値を設定する。
# ドキュメント中の例を固定値として利用しない。
BACKLOG_BASE_URL=https://fusic.backlog.jp

# 秘密情報。Git / ログ / 課題 / ゲーム内チャット / Adapter に配布しない (docs/spec.md §10)。
# ここにはプレースホルダーのみを書く。
BACKLOG_API_KEY=

# docs/design.md §9.1: MVP の safety assertion。TRAINING_YOSHIZUMI 以外は doctor が失敗する。
BACKLOG_PROJECT_KEY=TRAINING_YOSHIZUMI

# docs/design.md §9.2: Backlog 上で作成済みの Text 型 Custom Field の ID。
BACKLOG_REGISTRY_RECORD_TYPE_FIELD_ID=
BACKLOG_WORLD_KEY_FIELD_ID=
BACKLOG_ACHIEVEMENT_KEY_FIELD_ID=

# 完了状態 / Registry 課題の種別・優先度。対象 Project の設定値を指定する。
BACKLOG_DONE_STATUS_ID=
BACKLOG_REGISTRY_ISSUE_TYPE_ID=
BACKLOG_REGISTRY_PRIORITY_ID=

# docs/design.md §13.2 の既定値 (秒)。
BACKLOG_CONNECT_TIMEOUT=2
BACKLOG_REQUEST_TIMEOUT=8
