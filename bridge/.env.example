APP_NAME="Terraria Backlog Bridge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docs/design.md §2.1: 永続 DB / 永続 Queue / DB Session を MVP の前提にしない。
# アプリは DB_* を一切設定しなくても起動・テストできる。
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 正本にしない、再起動で消えてよいメモリキャッシュ (docs/design.md §2.1)。
CACHE_STORE=array

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Task 04: Achievement / Item catalog ---
# version-pinned Item catalog の探索ルート (docs/design.md §6.4)。
# `<base>/<terrariaVersion>/items.json` を読む。未設定ならリポジトリ同梱の
# contracts/terraria/ を使う。catalog が読めない Snapshot は fail closed。
# TERRARIA_ITEM_CATALOG_PATH=/path/to/contracts/terraria
