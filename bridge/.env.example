APP_NAME="Terraria Backlog Bridge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docs/design.md §2.1: 永続 DB / 永続 Queue / DB Session を MVP の前提にしない。
# アプリは DB_* を一切設定しなくても起動・テストできる。
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 正本にしない、再起動で消えてよいメモリキャッシュ (docs/design.md §2.1)。
CACHE_STORE=array

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Task 02: Snapshot API ---
# docs/design.md §6.1 / §16.1: Adapter -> PHP Bridge の Bearer Token。
# Backlog API Key とは別の秘密情報。実値は Git に入れない。
TERRARIA_ADAPTER_TOKEN=

# docs/design.md §5.2: 受理する world_key の allowlist (カンマ区切り)。
# URL の worldKey・payload の world.key・この値の 3 つが一致しないと 403。
TERRARIA_ALLOWED_WORLD_KEYS=terraria:123456789

# docs/design.md §2.3: 対応 runtime pair `<tshockVersion>:<terrariaVersion>`。
# 一致しない Snapshot は 409 で拒否する。
TERRARIA_SUPPORTED_RUNTIME=4.3.13:1.3.0.8

# docs/spec.md §6: 納品箱として扱う Chest 名。payload 側の値は信用しない。
TERRARIA_COLLECTION_CHEST_NAME=BACKLOG_COLLECTION

# docs/design.md §6.4 / docs/spec.md §10: 入力サイズ・件数の上限 (超過は Snapshot 全体を拒否)。
TERRARIA_MAX_REQUEST_BODY_BYTES=1048576
TERRARIA_MAX_JSON_DEPTH=32
TERRARIA_MAX_CHESTS=64
TERRARIA_MAX_ITEMS_PER_CHEST=40
TERRARIA_MAX_ITEMS_TOTAL=2560
TERRARIA_MAX_FLAGS=256
TERRARIA_MAX_TRIGGER_PLAYER_NAMES=32
TERRARIA_MAX_STRING_LENGTH=512
